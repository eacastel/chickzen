# Server-only Contentful delivery credentials (never NEXT_PUBLIC).
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Keep false for migration previews; enable only on the approved production release.
SITE_LAUNCHED=false
EMAIL_DELIVERY_ENABLED=false
CHECKOUT_ENABLED=false

# Transactional inquiry delivery through the project's existing Resend service.
# FROM must be a verified sender; TO is Jen's receiving inbox.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=hello@chickzen.com

# Optional, unchecked newsletter signup through Jen's MailerLite account.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Retained checkout; use test keys on preview deployments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CURRENCY_OVERRIDE=

# Dedicated Chickzen GTM container; existing GA4 G-6PCNC6QKXE is retained.
NEXT_PUBLIC_GTM_ID=GTM-WDHMFN7J
# Replaces direct GA tagging only in this migration; collection still requires
# SITE_LAUNCHED=true, VERCEL_ENV=production, an exact HTTPS Chickzen host and consent.
